import discord from discord.ext import commands intents = discord.Intents.default() intents.members = True # This is required to detect new members bot = commands.Bot(command_prefix="!", intents=intents) @bot.event async def on_ready(): print(f"Logged in as {bot.user}") @bot.event async def on_member_join(member): # Change "welcome" to the name of your channel channel = discord.utils.get(member.guild.text_channels, name="welcome") if channel: await channel.send(f"👋 Welcome {member.mention} to **{member.guild.name}**!") # Replace "YOUR_BOT_TOKEN" with your actual bot token bot.run("YOUR_BOT_TOKEN")
